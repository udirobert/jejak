# Copy to .env and fill in. .env is gitignored — never commit real values.
#
# These variables identify your Base44 app to the frontend SDK client
# (src/api/base44Client.js via src/lib/app-params.js).
# Running `base44 dev` / `base44 link` supplies them automatically; set them
# manually only when running `npm run dev` standalone against a hosted app.

# Your Base44 app id (shown in the Base44 dashboard / written by `base44 link`)
VITE_BASE44_APP_ID=

# Base URL of your Base44 app's backend
VITE_BASE44_APP_BASE_URL=

# Optional: pin a specific deployed functions version
# VITE_BASE44_FUNCTIONS_VERSION=

# ---------------------------------------------------------------------------
# Backend functions (base44/functions/) require NO secrets and no env vars:
#   - stellarMakerPayout derives a deterministic Stellar TESTNET signer funded
#     via Friendbot, and the demo cause wallets are public Testnet addresses
#     (G...) committed in the source.
#   - stellarFeeRelayer sponsors fees from its own isolated deterministic
#     Testnet account.
#   - Horizon (https://horizon-testnet.stellar.org) and Soroban RPC
#     (https://soroban-testnet.stellar.org) endpoints are public and hardcoded.
# Everything on-chain is TESTNET only — there is no mainnet path in this repo.
# ---------------------------------------------------------------------------
