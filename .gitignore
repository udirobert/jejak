# Video production project.
#
# The RECIPE is tracked — the ego capture scripts, the card templates, the
# fonts, the sound beds. Everything the recipe PRODUCES is not.
# (Note: gitignore has no trailing comments — a pattern with " # " after it
# is a literal pattern that matches nothing.)

# raw screen captures — re-recordable
video/raw/
# the finished cuts
video/out/
# TTS output
video/audio/
# rendered card stills
video/cards/
video/frames/
video/target/
video/*/target/
video/*/frames/
video/*/cards_media/
# rendered segments
video/*/assets/*.mp4
video/*/*.mp4
video/*/*.png
