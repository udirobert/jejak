{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "smart_product_verification_storytelling",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "write_journey_story": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "writeJourneyStory",
            "args": {
              "event": {
                "entity_name": "${ .trigger.entity_name }",
                "entity_id": "${ .trigger.entity_id }",
                "type": "${ .trigger.event_type }"
              },
              "data": "${ .trigger.data }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Write journey story",
            "description": "Generate field-journal entry for scan"
          }
        }
      }
    ]
  },
  "description": "Writes a short field-journal entry when a new Scan record is created.",
  "name": "Smart Product Verification & Storytelling",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "Scan"
    }
  }
}