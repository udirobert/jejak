{
  "name": "Guess",
  "type": "object",
  "properties": {
    "product_id": {
      "type": "string"
    },
    "product_name": {
      "type": "string"
    },
    "guess_pct": {
      "type": "number"
    },
    "user_id": {
      "type": "string"
    },
    "eligible": {
      "type": "boolean",
      "default": false
    },
    "salt": {
      "type": "string"
    },
    "guess_hash": {
      "type": "string"
    },
    "commit_tx": {
      "type": "string"
    },
    "explorer_url": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "committed",
        "won",
        "lost"
      ],
      "default": "committed"
    },
    "pot_xlm": {
      "type": "string"
    },
    "sponsored": {
      "type": "boolean",
      "default": true
    },
    "reveal_error_pct": {
      "type": "number"
    },
    "settle_tx": {
      "type": "string"
    },
    "settle_explorer": {
      "type": "string"
    },
    "winner_claim_address": {
      "type": "string"
    },
    "claim_balance_id": {
      "type": "string"
    },
    "claim_tx": {
      "type": "string"
    },
    "claim_explorer": {
      "type": "string"
    }
  }
}
