{
  "name": "Scan",
  "type": "object",
  "properties": {
    "product_id": {
      "type": "string"
    },
    "product_name": {
      "type": "string"
    },
    "emoji": {
      "type": "string"
    },
    "origin": {
      "type": "string"
    },
    "labour_pct": {
      "type": "number"
    },
    "price": {
      "type": "number"
    },
    "currency": {
      "type": "string"
    },
    "market": {
      "type": "string"
    },
    "photo_url": {
      "type": "string"
    },
    "confidence": {
      "type": "string"
    },
    "basis": {
      "type": "string"
    },
    "canonical_json": {
      "type": "string"
    },
    "stellar_tx_hash": {
      "type": "string"
    },
    "stellar_ledger": {
      "type": "number"
    },
    "stellar_memo": {
      "type": "string"
    },
    "record_sha256": {
      "type": "string"
    },
    "label_country": {
      "type": "string"
    },
    "label_materials": {
      "type": "string"
    },
    "sample_entry": {
      "type": "boolean",
      "default": false
    },
    "is_sample": {
      "type": "boolean",
      "default": false
    },
    "visibility": {
      "type": "string",
      "enum": [
        "private",
        "public"
      ],
      "default": "private"
    },
    "owner_id": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "sample",
        "photo",
        "describe",
        "receipt"
      ]
    },
    "trace_json": {
      "type": "string"
    },
    "route_json": {
      "type": "string"
    },
    "brand": {
      "type": "string"
    },
    "receipt_id": {
      "type": "string"
    },
    "distance_km": {
      "type": "number"
    },
    "labour_amount": {
      "type": "number"
    },
    "story_status": {
      "type": "string",
      "enum": [
        "pending",
        "writing",
        "done",
        "failed",
        "skipped"
      ]
    },
    "story_title": {
      "type": "string"
    },
    "story_text": {
      "type": "string"
    },
    "story_caption": {
      "type": "string"
    }
  },
  "required": [
    "product_id",
    "product_name",
    "origin",
    "labour_pct"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "data.visibility": {
            "$ne": "private"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.owner_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.owner_id": "{{user.id}}"
        }
      ]
    }
  }
}