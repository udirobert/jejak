{
  "name": "Receipt",
  "type": "object",
  "properties": {
    "file_uri": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "uploaded",
        "reading",
        "tracing",
        "done",
        "failed"
      ],
      "default": "uploaded"
    },
    "merchant": {
      "type": "string"
    },
    "purchase_date": {
      "type": "string"
    },
    "currency": {
      "type": "string"
    },
    "market": {
      "type": "string",
      "enum": [
        "GB",
        "SG"
      ]
    },
    "error": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "brand": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit_price": {
            "type": "number"
          },
          "traceable": {
            "type": "boolean"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "traced",
              "skipped",
              "failed"
            ],
            "default": "pending"
          },
          "scan_id": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "file_uri"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}