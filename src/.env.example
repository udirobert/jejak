# Jejak — Environment Variables (.env.example)
# Copy to .env for local or self-hosted deployments.
# IMPORTANT: Never commit real secret keys. Only Stellar TESTNET keys are used.

# Optional: Stellar Testnet relayer secret key (starts with 'S', 56 chars, funded via https://friendbot.stellar.org).
# If omitted, the backend function generates an ephemeral Testnet keypair in memory and funds it via Friendbot.
STELLAR_TESTNET_SIGNER_SECRET=

# Stellar Horizon Testnet endpoint (defaults to https://horizon-testnet.stellar.org)
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# Public Stellar Testnet addresses for the 4 Demo Cause Wallets (public keys only, start with 'G')
STELLAR_DEMO_CAUSE_PUBLIC_KEY_BD=GCHJR2K3HXX55NYA7ZYWZH6NZ3TOBTIQFUVZWPUZESAQJ2QFGX5PKVDC
STELLAR_DEMO_CAUSE_PUBLIC_KEY_VN=GB6NVEN5HSUBKMYCE5ZOWSK5K23TBWRUQLZY3KNMXUZ3AQ2U4MY42G4A
STELLAR_DEMO_CAUSE_PUBLIC_KEY_ET=GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN
STELLAR_DEMO_CAUSE_PUBLIC_KEY_CN=GDJWYEZ4SG7GI42ER6OYWHS5EORLEFDAMYFD5XVI4AXV3CALOPMOAOFT